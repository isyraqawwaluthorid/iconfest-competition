# =====================================================================
# SemarSight — contoh environment. Salin menjadi .env (worker) dan
# web/.env.local (web). JANGAN commit file .env yang berisi nilai asli.
# =====================================================================

# --- Supabase ---------------------------------------------------------
# Aman untuk browser (hanya URL dan anon key, RLS read-only)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# RAHASIA: hanya worker dan server Next.js
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=snapshots

# --- OpenAI (RAHASIA) -------------------------------------------------
OPENAI_API_KEY=
# Isi dengan model kecil terbaru yang mendukung input gambar + structured outputs.
# Cek https://platform.openai.com/docs/models sebelum mengisi.
OPENAI_VISION_MODEL=
OPENAI_TEXT_MODEL=

# --- Admin web --------------------------------------------------------
ADMIN_PASSWORD=ganti-dengan-password-kuat
ADMIN_SESSION_SECRET=ganti-dengan-string-acak-panjang

# --- Worker -----------------------------------------------------------
CYCLE_SECONDS=300
MAX_CONCURRENCY=8
FRAME_TIMEOUT_SECONDS=20
FRAMES_DIR=./frames
FRAMES_RETENTION_DAYS=14
YOLO_MODEL=yolo11s.pt
YOLO_CONF=0.25
AI_VISION_ENABLED=true
AI_DAILY_CALL_CAP=3000
WATER_ONLY_FEATURED=true
WATER_CHANGE_THRESHOLD=0.12
WATER_HEARTBEAT_MINUTES=30
WATER_RAIN_HEARTBEAT_MINUTES=10
RAIN_TRIGGER_MM=2.0
WEATHER_INTERVAL_MINUTES=30
INSIGHT_INTERVAL_MINUTES=15
TIMEZONE=Asia/Jakarta
HTTP_USER_AGENT=Mozilla/5.0 (compatible; SemarSight/0.1; +https://github.com/<akun>/<repo>)

# --- Fitur tambahan ----------------------
# Belum dibaca worker sampai fiturnya dikerjakan.
TELEGRAM_BOT_TOKEN=
BMKG_FORECAST_INTERVAL_MINUTES=180
BMKG_NOWCAST_INTERVAL_MINUTES=10

# --- Kualitas udara & emisi ---------
AIR_QUALITY_INTERVAL_MINUTES=60
FLOW_ENABLED=false
FLOW_INTERVAL_MINUTES=15
FLOW_CLIP_SECONDS=30
